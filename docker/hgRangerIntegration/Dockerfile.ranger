# Stage 1: build the thin hugegraph-ranger-plugin jar
FROM --platform=$BUILDPLATFORM maven:3.9.16-eclipse-temurin-17 AS build

WORKDIR /pkg

COPY . .

# This also produces the shaded "-plugin" artifact (~290 MB, mostly the audit
# backends ranger-plugins-audit requires: Solr, Elasticsearch, Kafka and the AWS
# SDK). That one is for HugeGraph's own lib/ and is NOT copied below: Ranger
# Admin already has ranger-plugins-common, gson and slf4j on its classpath, so
# only the thin jar is needed here.
#
# -Dwith-ranger-plugin is required, not optional: the plugin is an opt-in module,
# declared under that profile in hugegraph-server/pom.xml. Without the flag the
# module is not in the reactor and -pl fails with
# "Could not find the selected project in the reactor".
RUN --mount=type=cache,target=/root/.m2 \
    mvn package -pl hugegraph-server/hugegraph-ranger-plugin -am -e -B -ntp \
        -Dwith-ranger-plugin \
        -Dmaven.test.skip=true \
        -Dmaven.javadoc.skip=true \
        -Drat.skip=true \
        -Dcheckstyle.skip=true \
    && find hugegraph-server/hugegraph-ranger-plugin/target -maxdepth 1 \
        -name 'hugegraph-ranger-plugin-*.jar' ! -name '*-plugin.jar' \
        -exec cp {} /pkg/hugegraph-ranger-plugin.jar \;

# Stage 2: bake the service class into the stock Ranger Admin image
#
# Must stay in step with the ranger.version property in
# hugegraph-server/hugegraph-ranger-plugin/pom.xml, which decides the
# ranger-plugins-common version the jar is compiled against.
FROM apache/ranger:2.9.0

LABEL maintainer="HugeGraph Docker Maintainers <dev@hugegraph.apache.org>"

# The stock image runs Ranger Admin on Java 8, but the plugin jar is Java 17
# bytecode (HugeGraph's minimum). Ranger 2.9 supports a Java 17 runtime (see its
# dev-support/ranger-docker/.env), so swap in a Temurin 17 JRE. JAVA_OPTS is
# prepended to Ranger Admin's own options by ranger-admin-services.sh; the flags
# are the JDK 17 set from Ranger's docker setup.
COPY --from=eclipse-temurin:17-jre-jammy /opt/java/openjdk /opt/java/openjdk-17
ENV JAVA_HOME=/opt/java/openjdk-17 \
    PATH=/opt/java/openjdk-17/bin:$PATH \
    JAVA_OPTS="--add-opens=java.base/java.nio=ALL-UNNAMED --add-exports=java.base/sun.net.dns=ALL-UNNAMED --add-exports=java.base/sun.net.util=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-exports=java.xml.crypto/com.sun.org.apache.xml.internal.security.utils=ALL-UNNAMED"

# TEST STACK ONLY: let the HugeGraph plugin download policies without
# authenticating. Ranger 2.9 rejects anonymous plugin downloads by default
# ("Unauthenticated access not allowed"), and the plugin has no Ranger
# credentials configured here. Production deployments must authenticate the
# plugin (Kerberos or JWT) instead. Only /service/plugins/policies/download,
# /service/roles/download and /service/tags/download are opened. Patched in
# conf.dist because Ranger's first-run setup copies conf.dist into conf; the
# grep fails the build if a base image bump moves the property.
ARG ADMIN_DEFAULT_SITE=/opt/ranger/admin/ews/webapp/WEB-INF/classes/conf.dist/ranger-admin-default-site.xml
RUN sed -i '/<name>ranger.admin.allow.unauthenticated.download.access<\/name>/{n;s|<value>false</value>|<value>true</value>|}' \
        ${ADMIN_DEFAULT_SITE} \
    && grep -A1 '<name>ranger.admin.allow.unauthenticated.download.access</name>' ${ADMIN_DEFAULT_SITE} \
        | grep -q '<value>true</value>'

# Ranger Admin loads the service definition's implClass
# (org.apache.hugegraph.ranger.RangerHugeGraphService, see
# ranger-servicedef-hugegraph.json) from ranger-plugins/<service-type>/, where
# <service-type> is the service def name "hugegraph". That directory is scanned
# once at JVM startup, so baking the jar in is what makes "Test Connection" and
# the policy editor's resource autocomplete work on a plain `docker compose up`
# — no copy-into-the-container-and-restart dance.
#
# The /opt/ranger/admin symlink is used instead of the versioned
# ranger-<version>-admin directory so this path survives a base image bump.
ARG PLUGIN_DIR=/opt/ranger/admin/ews/webapp/WEB-INF/classes/ranger-plugins/hugegraph

RUN mkdir -p ${PLUGIN_DIR}

COPY --from=build --chown=ranger:ranger \
    /pkg/hugegraph-ranger-plugin.jar \
    ${PLUGIN_DIR}/hugegraph-ranger-plugin.jar
