<!--
  ranger-hugegraph-security.xml
  ==============================
  Ranger client configuration for the HugeGraph service plugin.
  Copy to /etc/ranger/hugegraph/ and adjust the values below.
  Reference this file via rest-server.properties:
      auth.ranger.config=/etc/ranger/hugegraph/ranger-hugegraph-security.xml
-->
<configuration>

    <!-- Ranger Admin URL -->
    <property>
        <name>ranger.plugin.hugegraph.policy.rest.url</name>
        <value>http://ranger-admin-host:6080</value>
        <description>URL of the Ranger Admin server</description>
    </property>

    <!-- Ranger service name (must match the service created in Ranger Admin) -->
    <property>
        <name>ranger.plugin.hugegraph.service.name</name>
        <value>hugegraph</value>
    </property>

    <!-- Policy refresh interval in milliseconds -->
    <property>
        <name>ranger.plugin.hugegraph.policy.pollIntervalMs</name>
        <value>30000</value>
    </property>

    <!-- Local policy cache directory -->
    <property>
        <name>ranger.plugin.hugegraph.policy.cache.dir</name>
        <value>/tmp/ranger/cache/hugegraph</value>
    </property>

    <!-- Policy source implementation (pull from Ranger Admin) -->
    <property>
        <name>ranger.plugin.hugegraph.policy.source.impl</name>
        <value>org.apache.ranger.admin.client.RangerAdminRESTClient</value>
    </property>

    <!-- Audit to Solr (optional) -->
    <property>
        <name>xasecure.audit.is.enabled</name>
        <value>true</value>
    </property>
    <property>
        <name>xasecure.audit.solr.is.enabled</name>
        <value>false</value>
    </property>

    <!-- Audit to HDFS (optional) -->
    <property>
        <name>xasecure.audit.hdfs.is.enabled</name>
        <value>false</value>
    </property>

    <!-- SSL for Ranger Admin communication (optional) -->
    <property>
        <name>ranger.plugin.hugegraph.policy.rest.ssl.config.file</name>
        <value />
    </property>

</configuration>
