<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.hugegraph</groupId>
        <artifactId>hugegraph-server</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hugegraph-ranger-plugin</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>Apache Ranger authorization plugin for HugeGraph</description>

    <properties>
        <ranger.version>2.4.0</ranger.version>
        <!-- Ranger Admin runs Java 8; compile to class file 52 so the plugin
             JAR loads on both HugeGraph (Java 11) and Ranger Admin (Java 8). -->
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- HugeGraph internal dependencies -->
        <dependency>
            <groupId>org.apache.hugegraph</groupId>
            <artifactId>hugegraph-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.hugegraph</groupId>
            <artifactId>hugegraph-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Apache Ranger plugin SDK -->
        <dependency>
            <groupId>org.apache.ranger</groupId>
            <artifactId>ranger-plugins-common</artifactId>
            <version>${ranger.version}</version>
            <exclusions>
                <!-- avoid hadoop/hbase version conflicts -->
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-common</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-auth</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- logging -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <!-- Hadoop configuration is pulled in by ranger-plugins-common at runtime;
             provided scope lets us compile against it without bundling it. -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-common</artifactId>
            <version>3.3.4</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                              Produce a standalone "plugin" jar that Ranger's
                              security-admin can pick up.  hugegraph-core and
                              hugegraph-api are already on the server classpath
                              so we exclude them to keep the artifact small.
                            -->
                            <artifactSet>
                                <excludes>
                                    <exclude>org.apache.hugegraph:hugegraph-core</exclude>
                                    <exclude>org.apache.hugegraph:hugegraph-api</exclude>
                                    <exclude>org.apache.hugegraph:hugegraph-common</exclude>
                                    <!-- Jersey 3.x and Jakarta JAX-RS are provided by
                                         HugeGraph's server classpath — exclude the whole
                                         transitive tree so the shaded JAR doesn't override
                                         HugeGraph's own jersey-server registration. -->
                                    <exclude>org.glassfish.jersey.*:*</exclude>
                                    <exclude>org.glassfish.hk2*:*</exclude>
                                    <exclude>jakarta.ws.rs:jakarta.ws.rs-api</exclude>
                                    <exclude>jakarta.inject:jakarta.inject-api</exclude>
                                    <exclude>jakarta.annotation:jakarta.annotation-api</exclude>
                                </excludes>
                            </artifactSet>
                            <!-- Strip signature files from bundled signed JARs to prevent
                                 SecurityException: Invalid signature file digest.
                                 Also strip any bundled persistence.xml — if this jar is ever
                                 placed on the Ranger Admin classpath it would produce a
                                 "Conflicting persistence unit definitions for name 'xa_server'"
                                 error because ranger-plugins-audit already declares that unit.
                                 Strip jakarta.ws.rs RuntimeDelegate registration — provided
                                 by HugeGraph's own Jersey JAR. -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/persistence.xml</exclude>
                                        <exclude>META-INF/services/jakarta.ws.rs.*</exclude>
                                        <exclude>META-INF/services/jakarta.xml.bind.*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!--
                              Relocate com.sun.jersey (Jersey 1.x client bundled by
                              ranger-plugins-common) and the javax.ws.rs API it relies
                              on into private packages so they do not conflict with
                              HugeGraph's Jakarta EE 3 / Jersey 3.x server classes.
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>com.sun.jersey</pattern>
                                    <shadedPattern>shaded.hugegraph.ranger.com.sun.jersey</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javax.ws.rs</pattern>
                                    <shadedPattern>shaded.hugegraph.ranger.javax.ws.rs</shadedPattern>
                                </relocation>
                                <!--
                                  Jersey 1.x/2.x (bundled by ranger-plugins-common) repackages ASM as
                                  jersey.repackaged.org.objectweb.asm.  Jersey 3.x (HugeGraph's server)
                                  repackages a NEWER version under the same package.  Without relocation
                                  the plugin JAR shadows Jersey 3.x's ASM, and ClassVisitor.<init>
                                  throws IllegalArgumentException on an unknown API version.
                                -->
                                <relocation>
                                    <pattern>jersey.repackaged</pattern>
                                    <shadedPattern>shaded.hugegraph.ranger.jersey.repackaged</shadedPattern>
                                </relocation>
                            </relocations>
                            <!--
                              Update META-INF/services/* entries to use relocated
                              class names (required for ServiceLoader-based JAX-RS
                              RuntimeDelegate discovery in shaded javax.ws.rs).
                            -->
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>plugin</shadedClassifierName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
